#!/usr/bin/env bash
set -e

APP_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PORT=1420
URL="http://127.0.0.1:${PORT}"
CONFIG_DIR="${HOME}/.config/orchestrator"
SYMLINK_PATH="${HOME}/.local/bin/orchestrator"
DESKTOP_PATH="${HOME}/.local/share/applications/orchestrator.desktop"
TAURI_BIN="${APP_DIR}/src-tauri/target/release/orchestrator"
LOG_FILE="/tmp/orchestrator-daemon.log"

# Dynamically resolve Node.js v18+ across PATH, NVM, FNM, Volta, and ASDF (preferring newest)
resolve_node() {
  local candidates=()

  if [ -d "${HOME}/.nvm/versions/node" ]; then
    while IFS= read -r b; do
      [ -n "$b" ] && candidates+=("$b")
    done < <(find "${HOME}/.nvm/versions/node" -maxdepth 3 -name node -type f 2>/dev/null | sort -V)
  fi

  for fnm_dir in "${HOME}/.fnm/node-versions" "${HOME}/.local/share/fnm/node-versions"; do
    if [ -d "$fnm_dir" ]; then
      while IFS= read -r b; do
        [ -n "$b" ] && candidates+=("$b")
      done < <(find "$fnm_dir" -maxdepth 4 -name node -type f 2>/dev/null | sort -V)
    fi
  done

  if [ -x "${HOME}/.volta/bin/node" ]; then
    candidates+=("${HOME}/.volta/bin/node")
  fi

  if [ "${#candidates[@]}" -gt 0 ]; then
    local newest="${candidates[${#candidates[@]}-1]}"
    if [ -x "$newest" ]; then
      echo "$newest"
      return 0
    fi
  fi

  if command -v node >/dev/null 2>&1; then
    command -v node
    return 0
  fi

  echo "Error: Node.js (v18+) is required but was not found." >&2
  exit 1
}

resolve_chrome() {
  for bin in google-chrome google-chrome-stable chromium chromium-browser /snap/bin/chromium; do
    if command -v "$bin" >/dev/null 2>&1; then
      command -v "$bin"
      return 0
    fi
  done
  echo "google-chrome"
}

NODE_BIN="$(resolve_node)"
NODE_DIR="$(dirname "$NODE_BIN")"
export PATH="${NODE_DIR}:${HOME}/.local/bin:/snap/bin:${PATH}"

is_daemon_running() {
  curl -s "${URL}/api/logs" >/dev/null 2>&1
}

start_daemon() {
  if ! is_daemon_running; then
    # Always re-bundle server/prod-server.ts -> server/prod-server.js (~7ms) so server/*.ts edits apply on restart
    if [ -x "${APP_DIR}/node_modules/.bin/esbuild" ]; then
      "${APP_DIR}/node_modules/.bin/esbuild" "${APP_DIR}/server/prod-server.ts" \
        --bundle --platform=node --format=esm --packages=external \
        --outfile="${APP_DIR}/server/prod-server.js" >/dev/null 2>&1 || true
    fi

    if command -v setsid >/dev/null 2>&1; then
      if [ -f "${APP_DIR}/server/prod-server.js" ]; then
        setsid "$NODE_BIN" --max-old-space-size=64 "${APP_DIR}/server/prod-server.js" </dev/null >"${LOG_FILE}" 2>&1 &
      else
        setsid "$NODE_BIN" --max-old-space-size=64 --experimental-strip-types "${APP_DIR}/server/prod-server.ts" </dev/null >"${LOG_FILE}" 2>&1 &
      fi
    else
      if [ -f "${APP_DIR}/server/prod-server.js" ]; then
        nohup "$NODE_BIN" --max-old-space-size=64 "${APP_DIR}/server/prod-server.js" </dev/null >"${LOG_FILE}" 2>&1 &
        disown $! 2>/dev/null || true
      else
        nohup "$NODE_BIN" --max-old-space-size=64 --experimental-strip-types "${APP_DIR}/server/prod-server.ts" </dev/null >"${LOG_FILE}" 2>&1 &
        disown $! 2>/dev/null || true
      fi
    fi

    for _ in {1..30}; do
      if is_daemon_running; then
        break
      fi
      sleep 0.1
    done

    if ! is_daemon_running; then
      echo "Warning: Orchestrator daemon failed to start. Check ${LOG_FILE} for details." >&2
      if [ -f "${LOG_FILE}" ]; then
        tail -n 10 "${LOG_FILE}" >&2
      fi
    fi
  fi
}

stop_daemon() {
  pkill -f "node.*server/prod-server" 2>/dev/null || true
}

stop_app() {
  pkill -f "target/release/orchestrator" 2>/dev/null || true
  stop_daemon
}

launch_ui() {
  start_daemon
  local launcher="nohup"
  if command -v setsid >/dev/null 2>&1; then
    launcher="setsid"
  fi

  if [ -x "${TAURI_BIN}" ]; then
    WEBKIT_DISABLE_DMABUF_RENDERER=1 $launcher "${TAURI_BIN}" "$@" </dev/null >/dev/null 2>&1 &
  else
    local chrome_bin
    chrome_bin="$(resolve_chrome)"
    $launcher "$chrome_bin" --app="${URL}" --class="Orchestrator" --new-window </dev/null >/dev/null 2>&1 &
  fi
}

cmd_install() {
  echo "==> Installing Orchestrator from ${APP_DIR}..."
  echo "    Using Node: $(${NODE_BIN} -v) (${NODE_BIN})"

  mkdir -p "${CONFIG_DIR}"

  echo "==> Installing npm dependencies & building frontend + server bundle..."
  (cd "${APP_DIR}" && npm install && npm run build)

  if [ ! -x "${TAURI_BIN}" ] || [ "$1" = "--tauri" ]; then
    if [ "$1" = "--tauri" ]; then
      echo "==> Building native Tauri desktop binary (cargo build --release)..."
      (cd "${APP_DIR}/src-tauri" && cargo build --release) || echo "    Warning: Tauri build failed; will use Chrome app window fallback."
    elif command -v cargo >/dev/null 2>&1; then
      if command -v pkg-config >/dev/null 2>&1 && ! pkg-config --exists dbus-1 2>/dev/null; then
        echo "==> Tauri system dependencies (libdbus-1-dev, etc.) not detected."
        echo "    Using Chrome app window fallback. (To build native Tauri binary, install dependencies and run: orchestrator install --tauri)"
      else
        echo "==> Building native Tauri desktop binary (cargo build --release)..."
        (cd "${APP_DIR}/src-tauri" && cargo build --release) || echo "    Warning: Tauri build failed; will use Chrome app window fallback."
      fi
    else
      echo "==> Rust/Cargo not found; skipping native Tauri binary build (will use Chrome app window fallback)."
    fi
  fi

  echo "==> Creating CLI symlink at ${SYMLINK_PATH}..."
  mkdir -p "$(dirname "${SYMLINK_PATH}")"
  chmod +x "${APP_DIR}/orchestrator"
  ln -sf "${APP_DIR}/orchestrator" "${SYMLINK_PATH}"

  if [ -f "${HOME}/.bashrc" ] && ! grep -q '\.local/bin' "${HOME}/.bashrc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "${HOME}/.bashrc"
  fi

  echo "==> Creating desktop launcher at ${DESKTOP_PATH}..."
  mkdir -p "$(dirname "${DESKTOP_PATH}")"
  cat > "${DESKTOP_PATH}" <<EOF
[Desktop Entry]
Name=Orchestrator
Comment=Manage Projects, Docker Compose Stacks, PhpStorm, Chrome Profiles & Container NPM Tasks
Exec=${APP_DIR}/orchestrator
Icon=${APP_DIR}/src-tauri/icons/128x128.png
Terminal=false
Type=Application
Categories=Development;IDE;Utility;
StartupWMClass=orchestrator
EOF

  echo "==> Starting background daemon..."
  stop_daemon
  start_daemon

  echo "✓ Orchestrator installed! Launch it from your App Menu or by running 'orchestrator'."
}

cmd_update() {
  echo "==> Updating Orchestrator in ${APP_DIR}..."
  if [ -d "${APP_DIR}/.git" ]; then
    (cd "${APP_DIR}" && git pull)
  fi

  echo "==> Installing npm dependencies & rebuilding frontend + server bundle..."
  (cd "${APP_DIR}" && npm install && npm run build)

  if [ "$1" = "--tauri" ] && command -v cargo >/dev/null 2>&1; then
    echo "==> Rebuilding native Tauri desktop binary..."
    (cd "${APP_DIR}/src-tauri" && cargo build --release)
  fi

  echo "==> Restarting background daemon..."
  stop_daemon
  start_daemon
  echo "✓ Orchestrator updated and daemon restarted at ${URL}"
}

cmd_uninstall() {
  echo "==> Stopping Orchestrator..."
  stop_app

  echo "==> Removing symlink and desktop entry..."
  rm -f "${SYMLINK_PATH}"
  rm -f "${DESKTOP_PATH}"
  rm -f "${LOG_FILE}"

  if [ "$1" = "--purge" ]; then
    echo "==> Removing saved configuration at ${CONFIG_DIR}..."
    rm -rf "${CONFIG_DIR}"
  else
    echo "    (Saved configs kept in ${CONFIG_DIR}. Run 'orchestrator uninstall --purge' to delete configs too.)"
  fi

  echo "✓ Orchestrator uninstalled."
}

cmd_status() {
  if is_daemon_running; then
    echo "Orchestrator daemon: RUNNING (${URL})"
  else
    echo "Orchestrator daemon: STOPPED"
  fi
  echo "Config directory:    ${CONFIG_DIR}"
  echo "CLI symlink:         ${SYMLINK_PATH}"
  echo "Desktop entry:       ${DESKTOP_PATH}"
}

cmd_help() {
  cat <<EOF
Orchestrator — Project Switcher & Docker Manager

Usage:
  orchestrator                  Launch Orchestrator desktop app (and start daemon if needed)
  orchestrator install          Build frontend (+ Tauri if needed) and install CLI & desktop shortcut
  orchestrator install --tauri  Force rebuild of the native Tauri Rust binary during install
  orchestrator update           Pull latest git changes, rebuild frontend, and restart daemon
  orchestrator update --tauri   Pull, rebuild frontend + native Tauri binary, and restart daemon
  orchestrator restart          Restart the background daemon on ${URL}
  orchestrator stop             Stop running Orchestrator window and background daemon
  orchestrator status           Show daemon and installation status
  orchestrator uninstall        Stop app and remove CLI symlink & desktop shortcut (keeps ~/.config/orchestrator)
  orchestrator uninstall --purge  Uninstall and also delete ~/.config/orchestrator
EOF
}

case "${1:-}" in
  install)
    shift
    cmd_install "$@"
    ;;
  update)
    shift
    cmd_update "$@"
    ;;
  uninstall|remove)
    shift
    cmd_uninstall "$@"
    ;;
  restart)
    stop_daemon
    start_daemon
    echo "✓ Orchestrator daemon restarted at ${URL}"
    ;;
  stop)
    stop_app
    echo "✓ Orchestrator stopped."
    ;;
  status)
    cmd_status
    ;;
  --daemon-only)
    start_daemon
    echo "Orchestrator daemon is running at ${URL}"
    ;;
  help|--help|-h)
    cmd_help
    ;;
  start|"")
    shift 2>/dev/null || true
    launch_ui "$@"
    ;;
  *)
    launch_ui "$@"
    ;;
esac
